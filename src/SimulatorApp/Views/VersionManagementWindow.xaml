<Window x:Class="SimulatorApp.Views.VersionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimulatorApp.ViewModels"
        Title="客户端版本管理"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:VersionManagementViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Background" Value="#4A90E2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#357ABD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5BA3F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#357ABD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCC"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 操作系统类型选择 -->
        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Background="#FAFAFA" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8">操作系统类型</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Windows" GroupName="OsType" IsChecked="{Binding IsWindows}" Margin="0,0,20,0" />
                    <RadioButton Content="Linux (CentOS 7)" GroupName="OsType" IsChecked="{Binding IsLinux}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 版本列表 -->
        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Background="White" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8">版本列表</TextBlock>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding CurrentVersions}"
                         SelectedItem="{Binding SelectedVersion}"
                         BorderBrush="#DDD"
                         BorderThickness="1"
                         Padding="5"
                         Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="5,3" FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="删除选中" Command="{Binding DeleteCommand}" 
                            Background="#E74C3C" BorderBrush="#C0392B" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="#666" FontSize="12">
                        提示：选中版本后点击删除
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 添加新版本 -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Background="#FAFAFA" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="新版本号：" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Padding="5" FontSize="13" />
                <Button Grid.Column="2" Content="添加" Command="{Binding AddCommand}" 
                        Background="#27AE60" BorderBrush="#229954" />
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复默认" Command="{Binding ResetCommand}" 
                    Background="#95A5A6" BorderBrush="#7F8C8D" />
            <Button Content="保存" Command="{Binding SaveCommand}" />
            <Button Content="关闭" Click="CloseButton_Click" 
                    Background="#95A5A6" BorderBrush="#7F8C8D" />
        </StackPanel>
    </Grid>
</Window>
