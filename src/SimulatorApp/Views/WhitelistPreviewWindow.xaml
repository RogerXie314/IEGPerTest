<Window x:Class="SimulatorApp.Views.WhitelistPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="白名单文件预览" 
        Height="700" 
        Width="1100"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="白名单文件预览" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- 文件信息 -->
        <Border Grid.Row="1" 
                BorderBrush="#DDD" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="10" 
                Background="#F9F9F9"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名：" FontWeight="SemiBold" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" Margin="0,0,20,4"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="文件版本：" FontWeight="SemiBold" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FileVersion}" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="白名单数量：" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EntryCount}" Foreground="DarkBlue" FontWeight="Bold"/>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="文件大小：" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding FileSize}"/>
            </Grid>
        </Border>

        <!-- 搜索框 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="搜索：" 
                       VerticalAlignment="Center" 
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Height="26"
                     ToolTip="输入文件名或Hash值进行搜索"/>
            <Button Grid.Column="2" 
                    Content="清除" 
                    Width="60" 
                    Height="26" 
                    Margin="8,0,0,0"
                    Command="{Binding ClearSearchCommand}"/>
        </Grid>

        <!-- 白名单列表 -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding FilteredEntries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F5F5"
                  RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60"/>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180"/>
                <DataGridTextColumn Header="文件路径" Binding="{Binding FullPath}" Width="*" MinWidth="250"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="60"/>
                <DataGridTextColumn Header="Hash类型" Binding="{Binding HashType}" Width="80"/>
                <DataGridTextColumn Header="Hash值" Binding="{Binding FileHash}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       VerticalAlignment="Center"
                       Foreground="Gray">
                <Run Text="显示："/>
                <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="Bold"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" 条"/>
            </TextBlock>
            
            <Button Grid.Column="1" 
                    Content="导出列表" 
                    Width="90" 
                    Height="32" 
                    Margin="0,0,10,0"
                    Command="{Binding ExportCommand}"/>
            <Button Grid.Column="2" 
                    Content="关闭" 
                    Width="90" 
                    Height="32" 
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
